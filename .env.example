# ===== 必填 =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 密碼保護（強烈建議設定）=====
# 留空 = 不啟用密碼。設定後使用者首次點開演練會被要求輸入。
APP_PASSWORD=fraud2026

# 管理後台密碼，網址 /admin?key=這個密碼
ADMIN_PASSWORD=change-me-please

# ===== 模型 =====
# 推薦：claude-haiku-4-5（便宜快速）
# 高品質：claude-sonnet-4-5
CLAUDE_MODEL=claude-haiku-4-5

# ===== 用量限制 =====
DAILY_LIMIT=500              # 全站每日最多演練次數
PER_IP_PER_MINUTE=20         # 每個 IP 每分鐘最多請求數
PER_IP_PER_DAY=50            # 每個 IP 每日最多演練次數
MAX_TURNS_PER_SESSION=30     # 單次演練最多回合數

# ===== Port（雲端會自動覆蓋）=====
PORT=3001
